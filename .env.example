# Copy to .env and fill in. .env is gitignored - never commit a real token.
#
# Read token from https://huggingface.co/settings/tokens
# For Llama-3.2 you must ALSO accept the licence at
# https://huggingface.co/meta-llama/Llama-3.2-1B-Instruct
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cache ROOT. Holds datasets/ and activations/. Big. Drive with room.
#   local:  D:/quantprobe_cache/activations
#   colab:  /content/drive/MyDrive/quantprobe
QUANTPROBE_CACHE=D:/quantprobe_cache

# HuggingFace's own cache (model weights, datasets).
HF_HOME=D:/quantprobe_cache/hf
