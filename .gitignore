# --- Environments ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Secrets: never commit an HF token ---
.env
*.token
secrets.yaml

# --- Cached activations: large, regenerable, NEVER committed ---
cache/
*.npy
*.npz
*.pt
*.safetensors

# --- Run logs ---
logs/
*.log

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Notebooks: outputs only, keep the .ipynb itself ---
.ipynb_checkpoints/

# --- results/ IS committed (metrics json + figures). Explicitly un-ignore
#     anything the blanket rules above would have swallowed. ---
!results/
!results/**/*.json
!results/**/*.png
!results/**/*.pdf
!results/**/*.csv
!results/**/*.npz
# Build artifact: the repo bundle uploaded to Colab. Regenerate, don't commit.
quantprobe_repo.zip

# Demo build artefact: 519 KB of inlined data, regenerated by the demo pipeline.
demo/truth_probe_console.html
node_modules/

# Build artefacts and local-only material
node_modules/
package.json
package-lock.json
PAPER.md
NOTES.md
